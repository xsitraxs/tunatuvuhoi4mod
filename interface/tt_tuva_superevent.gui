# Standalone window; no replacement of vanilla or TNO interface files.
guiTypes = {
	containerWindowType = {
		name = "TT_taishet_superevent_window"
		# BUGFIX 2026-11-06: position MUST rest on screen. With position y=-6000 the
		# window stays off-screen whenever the show animation does not run (or runs
		# toward `position`); scripted-gui visibility does not reliably trigger it.
		# show_position == position == {0,0}: visible under every animation semantic;
		# hide_position keeps the slide-away behaviour when the window closes.
		position = { x = 0 y = 0 }
		show_position = { x = 0 y = 0 }
		hide_position = { x = 0 y = -6000 }
		animation_time = 0.6
		show_animation_type = decelerated
		hide_animation_type = accelerated
		size = { width = 640 height = 460 }
		orientation = center
		origo = center
		moveable = yes
		clipping = no
		show_sound = TT_taishet_super_reveal
		iconType = {
			name = "TT_taishet_frame"
			spriteType = "GFX_TT_taishet_super_frame"
			position = { x = 0 y = 0 }
		}
		instantTextBoxType = {
			name = "TT_taishet_kicker"
			position = { x = 35 y = 12 }
			font = "hoi_16mbs"
			text = "TT_taishet_super_kicker"
			format = centre
			maxWidth = 570
			maxHeight = 22
		}
		iconType = {
			name = "TT_taishet_image"
			spriteType = "GFX_TT_taishet_super_image"
			position = { x = 20 y = 42 }
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "TT_taishet_title"
			position = { x = 20 y = 284 }
			font = "hoi_24header"
			text = "TT_taishet_super_title"
			format = centre
			maxWidth = 600
			maxHeight = 34
		}
		instantTextBoxType = {
			name = "TT_taishet_quote"
			position = { x = 35 y = 328 }
			font = "hoi_18mbs"
			text = "TT_taishet_super_quote"
			format = centre
			maxWidth = 570
			maxHeight = 44
		}
		instantTextBoxType = {
			name = "TT_taishet_caption"
			position = { x = 35 y = 378 }
			font = "hoi_16mbs"
			text = "TT_taishet_super_caption"
			format = centre
			maxWidth = 570
			maxHeight = 20
		}
		buttonType = {
			name = "TT_taishet_close"
			position = { x = 180 y = 410 }
			# spriteType (not quadTextureSprite: that one is for tiled/cornered
			# sprites) + vanilla clicksound, matching the proven DVE close button.
			spriteType = "GFX_TT_taishet_super_button"
			buttonText = "TT_taishet_super_close"
			buttonFont = "hoi_16mbs"
			shortcut = "ESCAPE"
			clicksound = decisions_ui_button
		}
	}
}
